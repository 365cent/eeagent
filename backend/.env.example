# Copy to .env and fill in the gateway key. Anything not listed here keeps the
# default from app/core/config.py (timeouts, retries, upload caps, capture
# worker, trusted proxies, LaunchDarkly key). Add a line only to override one.
APP_ENV=development

# PostgreSQL
DB_HOST=127.0.0.1
# Windows portable Postgres: 54329. Linux/macOS Postgres: 5432.
DB_PORT=5432
DB_USER=eea
DB_PASSWORD=eea
DB_NAME=eea

# Model gateway: one URL and one key for every model call
CHAT_BASE_URL=https://your-gateway.example.com/v1
CHAT_API_KEY=

# Chat model: empty lets the gateway pick; comma-separated ids are tried in order.
CHAT_MODEL=
# Vision model: first id is preferred, the rest are fallbacks (comma-separated).
VISION_MODEL=

# Chat/vision resilience (hedge, TTFT, studio wall clock, retries): defaults in
# app/core/config.py are tuned for slow intranet gateways. Uncomment to override:
# CHAT_HEDGE_DELAY_SECONDS=4
# CHAT_HEDGE_MAX_MODELS=4
# CHAT_FIRST_TOKEN_TIMEOUT_SECONDS=90
# CHAT_ANSWER_PEEK_SECONDS=6
# CHAT_REQUEST_TOTAL_TIMEOUT_SECONDS=180
# CHAT_ATTEMPT_BUDGET_FLOOR=30
# CHAT_MODEL_SPEED_TTL_SECONDS=1800
# VISION_RETRY_BASE_DELAY_SECONDS=1.5

# Embedding and rerank (same gateway unless set separately)
EMBEDDING_BASE_URL=https://your-gateway.example.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Qwen3-Embedding-8B

RERANK_BASE_URL=https://your-gateway.example.com/v1
RERANK_API_KEY=
RERANK_MODEL=Qwen3-Reranker-8B

# Audit identity while APP_ENV=development; production identities come from OPS-03.
DEV_OPERATOR_SUBJECT=local-development-user
DEV_OPERATOR_ROLE=researcher
