LLM_BASE_URL=http://model-api.example.com/v1
LLM_API_KEY=
APP_ENV=development
# Development audit identity is fixed by server config; request bodies cannot override it.
DEV_OPERATOR_SUBJECT=local-development-user
DEV_OPERATOR_ROLE=researcher
# Production accepts X-EEA-Authenticated-User/Role only from these direct proxy peers.
# TRUSTED_PROXY_IPS=127.0.0.1,10.20.0.10/32
TRUSTED_PROXY_IPS=
# Server-side URL fetching is opt-in for local development and is always disabled in production.
CAPTURE_SERVER_FETCH_ENABLED=false
# Durable capture worker polling and recovery policy.
CAPTURE_WORKER_POLL_SECONDS=1
CAPTURE_WORKER_LEASE_SECONDS=900
CAPTURE_WORKER_MAX_ATTEMPTS=3
# 对话模型：留空 = 自动从 /models 选可用模型，并做单轮探测（max_tokens=1）
LLM_MODEL=
EMBEDDING_MODEL=Qwen3-Embedding-8B
RERANK_MODEL=Qwen3-Reranker-8B
# 视觉模型：留空 = 自动按 Qwen 3.8 → 3.6 匹配 /models；也可显式指定
VISION_MODEL=

# 文档：POST /documents/raw 体积上限与 MarkItDown 同步解析上限（默认各 120 MiB）
# DOC_RAW_UPLOAD_MAX_BYTES=125829120
# DOC_INGEST_MAX_BYTES=125829120
