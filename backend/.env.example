APP_ENV=development
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=eea
DB_PASSWORD=eea
DB_NAME=eea
# Local object store for capture payloads and signal bodies; API and worker must match.
# OBJECT_DIR=/var/lib/eea/objects

# --- OpenAI-compatible chat + vision (same host for both) ---
# Chat/tags/excerpt: POST {LLM_BASE_URL}/chat/completions
# Figure captions: same URL + LLM_API_KEY, model = VISION_MODEL (or auto Qwen 3.8/3.6)
LLM_BASE_URL=https://your-gateway.example.com/v1
LLM_API_KEY=
# Optional; when empty the server probes GET /models and picks a chat-capable id
# Chat/studio/tags: sent as OpenAI ``model`` on LLM_BASE_URL (e.g. auto, deepseek-v4-flash).
# Empty = probe /models order and cache the first id that answers a ping; studio retries use the list.
LLM_MODEL=auto
# Vision model id on the same LLM_BASE_URL (e.g. deepseek-v4.1-flash)
VISION_MODEL=

# --- MaaS embedding / rerank only (not used for vision) ---
MAAS_API_BASE_URL=
MAAS_API_KEY=
EMBEDDING_MODEL=Qwen3-Embedding-8B
RERANK_MODEL=Qwen3-Reranker-8B

# Development audit identity is fixed by server config; request bodies cannot override it.
DEV_OPERATOR_SUBJECT=local-development-user
DEV_OPERATOR_ROLE=researcher
TRUSTED_PROXY_IPS=
CAPTURE_SERVER_FETCH_ENABLED=false
CAPTURE_WORKER_POLL_SECONDS=1
CAPTURE_WORKER_LEASE_SECONDS=900
CAPTURE_WORKER_MAX_ATTEMPTS=3

# Vision-caption budget per HTML/document ingest
MAX_FIGURES=16
VISION_CAPTION_RETRY=2

# Document upload caps (default 120 MiB each)
# DOC_RAW_UPLOAD_MAX_BYTES=125829120
# DOC_INGEST_MAX_BYTES=125829120
# DOC_INGEST_VISION_TIMEOUT_SECONDS=120
