FROM node:22-bookworm AS build

# The intranet host only reaches registry.npmjs.org through the build proxy;
# docker-compose passes these args, but a RUN step only sees them when declared.
ARG HTTP_PROXY=""
ARG HTTPS_PROXY=""
ARG NO_PROXY=""
ENV HTTP_PROXY=$HTTP_PROXY \
    HTTPS_PROXY=$HTTPS_PROXY \
    NO_PROXY=$NO_PROXY \
    # Build-stage only: the proxy intercepts TLS with a CA the node image lacks.
    # Package authenticity still comes from the lockfile integrity hashes.
    NODE_TLS_REJECT_UNAUTHORIZED=0

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@12.3.4 --activate

# registry.npmjs.org is slow through the intranet proxy (tarballs time out);
# the lockfile stores integrity only, so a mirror does not change the graph.
# strict-ssl: the build proxy is a TLS-inspecting mitmproxy whose CA is not in
# the node image; the deploy host itself sets strict-ssl=false for npm.
RUN pnpm config set registry https://registry.npmmirror.com \
 && pnpm config set strict-ssl false \
 && pnpm config set fetch-timeout 120000 \
 && pnpm config set fetch-retries 5 \
 && pnpm config set fetch-retry-maxtimeout 60000

COPY frontend/package.json frontend/pnpm-lock.yaml ./
# Match CI/dev when package.json pins pnpm but lockfile has no boot document (pmOnFail=ignore).
ENV PNPM_CONFIG_PMONFAIL=ignore
RUN pnpm install --frozen-lockfile

COPY frontend/ .

ARG NEXT_PUBLIC_EEA_API_BASE=/api/v1
ENV NEXT_PUBLIC_EEA_API_BASE=$NEXT_PUBLIC_EEA_API_BASE

RUN pnpm build

FROM node:22-bookworm AS runtime

WORKDIR /app

ENV NODE_ENV=production \
    PORT=3000 \
    HOSTNAME=0.0.0.0

# Next standalone ships its own server and the traced node_modules; static
# assets are not traced and must be copied next to server.js (OPS-02).
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public

EXPOSE 3000

CMD ["node", "server.js"]
