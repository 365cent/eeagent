[Unit]
Description=EEA orphan-object maintenance
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=eea
Group=eea
WorkingDirectory=/opt/eea/current/backend
EnvironmentFile=/etc/eea/eea-api.env
Environment=PYTHONPATH=/opt/eea/current/backend/site-packages
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m app.services.orphan_maintenance
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/eea/objects

[Install]
WantedBy=multi-user.target
