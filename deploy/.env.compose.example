# Copy to deploy/.env before: docker compose up -d
# Do not commit deploy/.env (secrets).

APP_ENV=production
DB_USER=eea
DB_PASSWORD=change-me-in-production
DB_NAME=eea

# Public HTTP port on the host (Nginx container)
EEA_HTTP_PORT=8080

CAPTURE_SERVER_FETCH_ENABLED=false

# Same-origin browser via Nginx — leave empty when UI is served on the same host:port
CORS_ORIGINS=
CORS_ORIGIN_REGEX=

# Docker bridge ranges; narrow to your edge proxy IPs in production
TRUSTED_PROXY_IPS=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# Optional gateways (set in real intranet)
# LLM_BASE_URL=
# LLM_API_KEY=
# MAAS_API_BASE_URL=
# MAAS_API_KEY=
