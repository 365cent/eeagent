# Copy to deploy/.env before the first start (deploy/build.sh does this for you,
# and generates a random DB_PASSWORD if the file is missing).
# Never commit deploy/.env.

APP_ENV=production
EEA_VERSION=latest

DB_USER=eea
DB_NAME=eea
# Generated by deploy/build.sh when empty; change before exposing the host.
DB_PASSWORD=

# Public HTTP port on the host (Nginx container). Put the TLS proxy in front.
EEA_HTTP_PORT=8080

CAPTURE_SERVER_FETCH_ENABLED=false

# Same-origin browser through Nginx: leave empty when UI and API share host:port.
CORS_ORIGINS=
CORS_ORIGIN_REGEX=

# Only peers listed here may send identity headers (edge proxy addresses).
TRUSTED_PROXY_IPS=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# OPS-03 interim identity: with APP_ENV=production the API only accepts the
# operator from a trusted proxy, and nginx stamps this one. Leave both empty to
# keep every audited write returning 401 until a real identity proxy is wired.
# EEA_PILOT_OPERATOR=
# EEA_PILOT_ROLE=researcher

# Optional model gateways (intranet addresses); empty keeps the degraded mode.
# CHAT_BASE_URL=
# CHAT_API_KEY=
# CHAT_MODEL=
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=
# RERANK_BASE_URL=
# RERANK_API_KEY=
# RERANK_MODEL=
