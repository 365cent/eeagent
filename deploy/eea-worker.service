[Unit]
Description=EEA durable capture worker
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=eea
Group=eea
WorkingDirectory=/opt/eea/current/backend
EnvironmentFile=/etc/eea/eea-api.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/eea/current/backend/.venv/bin/python -m app.worker
Restart=on-failure
RestartSec=3s
TimeoutStopSec=60s
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/eea/objects

[Install]
WantedBy=multi-user.target
