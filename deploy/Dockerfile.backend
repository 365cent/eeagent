# EEA backend: FastAPI API, capture worker and Alembic migrations.
# One image serves the migrate / api / worker / maintenance services.
FROM python:3.12-slim-bookworm

ARG PIP_INDEX_URL=""
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1 \
    OBJECT_DIR=/var/lib/eea/objects

RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq5 curl fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir uv

WORKDIR /app
COPY backend /app

# The intranet build often needs a mirror; leave the arg empty to use PyPI.
RUN if [ -n "${PIP_INDEX_URL}" ]; then export UV_DEFAULT_INDEX="${PIP_INDEX_URL}"; fi \
    && uv sync --locked --no-dev

RUN mkdir -p /var/lib/eea/objects

EXPOSE 8000
CMD ["uv", "run", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
