# Linux intranet API + worker image (Python 3.12, uv lockfile).
FROM python:3.12-slim-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq5 curl fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1 \
    OBJECT_DIR=/var/lib/eea/objects

RUN pip install --no-cache-dir uv

COPY backend /app
RUN uv sync --locked --no-dev

RUN mkdir -p /var/lib/eea/objects

EXPOSE 8000

CMD ["uv", "run", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
