# LaunchDarkly browser SDK (client-side ID from Project settings → Environments → test)
# NEXT_PUBLIC_LAUNCHDARKLY_CLIENT_SIDE_ID=

# Optional override; default is same-origin /api/v1 (proxied by Next.js to FastAPI via EEA_API_ORIGIN)
# NEXT_PUBLIC_EEA_API_BASE=http://127.0.0.1:3000/api/v1
# EEA_API_ORIGIN=http://127.0.0.1:8000
