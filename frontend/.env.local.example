# LaunchDarkly browser SDK (client-side ID from Project settings → Environments → test)
# NEXT_PUBLIC_LAUNCHDARKLY_CLIENT_SIDE_ID=

# Optional override. Browser dev defaults to http://<hostname>:8000/api/v1 (bypasses Next proxy).
# NEXT_PUBLIC_EEA_API_BASE=http://127.0.0.1:8000/api/v1
# Server-side rewrites (large multipart uploads still use Next → FastAPI):
# EEA_API_ORIGIN=http://127.0.0.1:8000
